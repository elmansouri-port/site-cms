# Copy to .env and change every secret before deploying.
# docker compose reads this file automatically.

# ── Ports ─────────────────────────────────────────────────────────────────────
GATEWAY_PORT=8080

# ── Public URLs ───────────────────────────────────────────────────────────────
# The origin visitors use. Canonical URLs, hreflang, OG tags and the sitemap are
# all built from this, so it must be the real public address in production.
SITE_URL=http://localhost:8080
ADMIN_URL=http://localhost:8080/admin
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=rainbow
MONGO_ROOT_PASSWORD=change-me-mongo-password
MONGO_DB=rainbow_cms

# ── Secrets ───────────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-character-random-string
PREVIEW_SECRET=change-me-preview-secret
REVALIDATE_SECRET=change-me-revalidate-secret

# ── First administrator ───────────────────────────────────────────────────────
# Created on first boot when the database is empty.
ADMIN_EMAIL=admin@rainbow.local
ADMIN_PASSWORD=ChangeMe!2024
ADMIN_NAME=Administrator

# ── Behaviour ─────────────────────────────────────────────────────────────────
DEFAULT_LOCALE=fr
LOG_LEVEL=info
CACHE_TTL=300
WEB_CACHE_TTL=30
