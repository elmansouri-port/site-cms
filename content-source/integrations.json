{
  "_comment": [
    "Third-party endpoints the authored pages call, and the path each one answers",
    "to on this origin instead. Seeded into the CMS on `npm run seed`; after that",
    "the CMS owns the records and the upstream URL is never returned by any public",
    "endpoint.",
    "",
    "The verification tools read this file so they can reproduce the substitution",
    "without holding a credential. Only `slug` appears in rendered output, so",
    "changing an upstream URL in the CMS does not make this file stale — adding,",
    "removing or renaming an integration does.",
    "",
    "responseMode:",
    "  ok      the browser is told success or failure and nothing else",
    "  fields  only the listed keys are copied out of the upstream response",
    "Nothing is ever passed through wholesale."
  ],
  "integrations": [
    {
      "slug": "livre-blanc-lead",
      "label": "Whitepaper download",
      "url": "https://n8n.openrainbow.org/webhook/livre-blanc-lead",
      "method": "POST",
      "responseMode": "ok",
      "responseFields": [],
      "captureLead": true,
      "leadType": "whitepaper",
      "note": "The whitepaper modal. The e-mail with the document is sent by the workflow."
    },
    {
      "slug": "demo-request-lead",
      "label": "Demo request",
      "url": "https://n8n.openrainbow.org/webhook/demo-request-lead",
      "method": "POST",
      "responseMode": "ok",
      "responseFields": [],
      "captureLead": true,
      "leadType": "demo",
      "note": "The demo form on the product pages."
    },
    {
      "slug": "booking",
      "label": "Appointment booking",
      "url": "https://n8n.openrainbow.org/webhook/booking",
      "method": "POST",
      "responseMode": "fields",
      "responseFields": ["ok", "reference", "message", "start", "end"],
      "captureLead": true,
      "leadType": "booking",
      "note": "Books the slot. The reference is shown to the visitor, so it is allowed through."
    },
    {
      "slug": "availability",
      "label": "Appointment availability",
      "url": "https://n8n.openrainbow.org/webhook/availability",
      "method": "POST",
      "responseMode": "fields",
      "responseFields": ["ok", "slots", "days", "timezone"],
      "captureLead": false,
      "note": "Reads free slots for the booking calendar. No lead: nobody has asked for anything yet."
    },
    {
      "slug": "booking-lookup",
      "label": "Find a booking",
      "url": "https://n8n.openrainbow.org/webhook/booking-lookup",
      "method": "POST",
      "responseMode": "fields",
      "responseFields": ["ok", "found", "reference", "start", "end", "name", "message"],
      "captureLead": false
    },
    {
      "slug": "booking-confirm",
      "label": "Confirm a booking",
      "url": "https://n8n.openrainbow.org/webhook/booking-confirm",
      "method": "POST",
      "responseMode": "fields",
      "responseFields": ["ok", "reference", "message"],
      "captureLead": false
    },
    {
      "slug": "booking-change",
      "label": "Move a booking",
      "url": "https://n8n.openrainbow.org/webhook/booking-change",
      "method": "POST",
      "responseMode": "fields",
      "responseFields": ["ok", "reference", "start", "end", "message"],
      "captureLead": false
    },
    {
      "slug": "booking-cancel",
      "label": "Cancel a booking",
      "url": "https://n8n.openrainbow.org/webhook/booking-cancel",
      "method": "POST",
      "responseMode": "fields",
      "responseFields": ["ok", "message"],
      "captureLead": false
    },
    {
      "slug": "unsubscribe",
      "label": "Unsubscribe",
      "url": "https://n8n.openrainbow.org/webhook/unsubscribe",
      "method": "POST",
      "responseMode": "fields",
      "responseFields": ["ok", "message"],
      "captureLead": true,
      "leadType": "unsubscribe"
    },
    {
      "slug": "unsubscribe-check",
      "label": "Unsubscribe lookup",
      "url": "https://n8n.openrainbow.org/webhook/unsubscribe-check",
      "method": "POST",
      "responseMode": "fields",
      "responseFields": ["ok", "found", "email", "lists", "message"],
      "captureLead": false
    }
  ]
}
