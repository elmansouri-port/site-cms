---
/*
 * SectionRenderer — the registry dispatch (reco.md 8.3).
 *
 * A block names a component with a string key; this maps that key to a real
 * component. An unknown key logs a warning and renders nothing, so a bad
 * reference in the database can never take a page down.
 */
import BlockWrapper from './BlockWrapper.astro';
import Hero from './blocks/Hero.astro';
import CtaBanner from './blocks/CtaBanner.astro';
import FaqAccordion from './blocks/FaqAccordion.astro';
import FeatureGrid from './blocks/FeatureGrid.astro';
import StatsBand from './blocks/StatsBand.astro';
import LogoMarquee from './blocks/LogoMarquee.astro';
import RichText from './blocks/RichText.astro';
import ImageText from './blocks/ImageText.astro';
import PricingCards from './blocks/PricingCards.astro';
import VideoBlock from './blocks/VideoBlock.astro';
import ArticleList from './blocks/ArticleList.astro';
import FormBlock from './blocks/FormBlock.astro';
import RawHtml from './blocks/RawHtml.astro';
import CustomHtml from './blocks/CustomHtml.astro';

const REGISTRY = {
  hero: Hero,
  cta_banner: CtaBanner,
  faq_accordion: FaqAccordion,
  feature_grid: FeatureGrid,
  stats_band: StatsBand,
  logo_marquee: LogoMarquee,
  rich_text: RichText,
  image_text: ImageText,
  pricing_cards: PricingCards,
  video: VideoBlock,
  article_list: ArticleList,
  form: FormBlock,
  raw_html: RawHtml,
  custom_html: CustomHtml,
};

const { block, locale, context, editMode = false } = Astro.props;
const Component = REGISTRY[block?.componentKey];

if (!Component) {
  console.warn(`[sections] no component registered for "${block?.componentKey}" — block skipped`);
}
---

{Component && (
  <BlockWrapper layout={block.layout} anchorId={block.anchorId} block={block} editMode={editMode}>
    {/*
      `editMode` is threaded into the block, not only into the wrapper.

      A block that renders a link from one of its fields has to be able to say
      which field, so a click on the canvas can be mapped back to it — and that
      attribute must never appear in a published page. Without this the wrapper
      knew it was a preview and the block did not.
    */}
    <Component data={block.data || {}} locale={locale} context={context} block={block} editMode={editMode} />
  </BlockWrapper>
)}
