---
/*
 * LogoMarquee — the scrolling customer logo band. The list is duplicated in
 * the markup so the CSS animation loops seamlessly; the copy is hidden from
 * assistive tech.
 */
const { data = {} } = Astro.props;
const { title = '', logos = [] } = data;
---

<div class="relative w-full overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    {title && <p class="text-center text-sm uppercase tracking-wide text-gray-400 mb-8">{title}</p>}
    <div class="marquee-container relative flex overflow-x-hidden">
      <div class="flex animate-marquee whitespace-nowrap gap-10 md:gap-[7rem] items-center py-4">
        {logos.map((logo) => (
          <div class="flex-shrink-0 flex items-center justify-center">
            <img src={logo.src} alt={logo.alt || ''} width={logo.width || 140} height={logo.height || 48} loading="lazy" decoding="async" class="h-10 w-auto object-contain" />
          </div>
        ))}
        {logos.map((logo) => (
          <div class="flex-shrink-0 flex items-center justify-center" aria-hidden="true">
            <img src={logo.src} alt="" width={logo.width || 140} height={logo.height || 48} loading="lazy" decoding="async" class="h-10 w-auto object-contain" />
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
