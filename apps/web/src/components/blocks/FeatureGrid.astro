---
/*
 * FeatureGrid — two to four columns of icon + title + copy.
 */
const { data = {} } = Astro.props;
const { title = '', subtitle = '', columns = 3, items = [] } = data;
const cols = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-4' }[columns] || 'md:grid-cols-3';
---

<div class="max-w-6xl mx-auto px-6">
  {title && <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center">{title}</h2>}
  {subtitle && <p class="mt-4 text-gray-600 text-center max-w-2xl mx-auto">{subtitle}</p>}

  <div class={`grid grid-cols-1 ${cols} gap-8 mt-12`}>
    {items.map((item) => (
      <div class="p-7 rounded-2xl border border-gray-100 bg-white shadow-sm hover:shadow-md transition-shadow">
        {item.icon && (
          <img src={item.icon} alt="" width="40" height="40" loading="lazy" decoding="async" class="w-10 h-10 mb-4" />
        )}
        {item.title && <h3 class="text-lg font-semibold text-gray-900">{item.title}</h3>}
        {item.description && <p class="mt-2 text-gray-600 leading-relaxed">{item.description}</p>}
        {item.linkLabel && (
          <a href={item.linkHref} class="inline-flex items-center gap-1 mt-4 text-brand-500 font-medium hover:underline">
            {item.linkLabel}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        )}
      </div>
    ))}
  </div>
</div>
