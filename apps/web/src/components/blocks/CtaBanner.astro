---
/*
 * CtaBanner — the closing call to action used across the site.
 */
import { linkAttrs } from '../../lib/links.js';

const { data = {}, editMode = false } = Astro.props;
const {
  title = '',
  subtitle = '',
  primaryLabel = '',
  primaryHref = '',
  secondaryLabel = '',
  secondaryHref = '',
  background = '',
} = data;

/*
 * Names the field a link came from, for the visual editor only.
 *
 * A click on the canvas can find the block it landed in, but not which of the
 * block's fields drew that button — the href has already been resolved from a
 * `page:` reference and rewritten for the locale, so it cannot be matched back.
 * Emitted in edit mode and never in a published page.
 */
const fieldHook = (name) => (editMode ? { 'data-cms-field': name } : {});

const style = background ? `background-image:linear-gradient(rgba(94,45,145,.88),rgba(94,45,145,.88)),url('${background}');background-size:cover;background-position:center;` : '';
---

<div class="max-w-6xl mx-auto px-6">
  <div class="sp-cta-banner rounded-3xl bg-brand-500 text-white px-8 py-14 md:px-16 text-center" style={style}>
    {title && <h2 class="text-3xl md:text-4xl font-bold">{title}</h2>}
    {subtitle && <p class="mt-4 text-white/85 text-lg max-w-2xl mx-auto">{subtitle}</p>}
    {(primaryLabel || secondaryLabel) && (
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-9">
        {primaryLabel && (
          <a {...linkAttrs(primaryHref, data.primaryNewTab)} class="px-7 py-3 rounded-btn bg-white text-brand-500 font-medium hover:bg-gray-100 transition-colors" {...fieldHook('primaryHref')}>
            {primaryLabel}
          </a>
        )}
        {secondaryLabel && (
          <a {...linkAttrs(secondaryHref, data.secondaryNewTab)} class="px-7 py-3 rounded-btn border border-white/60 text-white font-medium hover:bg-white/10 transition-colors" {...fieldHook('secondaryHref')}>
            {secondaryLabel}
          </a>
        )}
      </div>
    )}
  </div>
</div>
