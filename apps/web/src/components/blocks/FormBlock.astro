---
/*
 * FormBlock — a CMS-managed form on a page.
 *
 * Almost nothing happens here. The markup comes from `renderForm` in
 * `@rainbow/core/form`, which is the same function the article renderer and the
 * CMS's preview pane call, so a form cannot look or behave differently depending
 * on where it was placed. The submit handler is `/js/cms-form.js`, loaded once.
 *
 * Two shapes of input, because a form can be either shared or local:
 *
 *   data.form      a saved form, resolved into the block by the API when it
 *                  serves the page — the normal case, and what lets one demo
 *                  form serve four product pages
 *   data.fields    a form defined in the block itself, for a one-off that is
 *                  not worth naming
 *
 * The browser posts to this origin either way; the automation platform's own
 * address never reaches a page. See routes/hooks.js.
 */
import { renderForm } from '@rainbow/core/form';

const { data = {}, locale = 'fr', block = null, editMode = false } = Astro.props;

/*
 * A form defined in the block looks enough like a saved one to render through
 * the same function. The difference is only where it came from.
 */
const inline = {
  key: `block-${block?.key || 'form'}`,
  target: data.submitTo || 'lead:contact',
  fields: (Array.isArray(data.fields) ? data.fields : []).map((field, i) => ({
    ...field,
    key: field.key || field.name || `f${i}`,
    // An inline field's copy is plain strings, not per-locale maps: a one-off
    // form is written in one language by the person placing it.
    label: field.label,
    placeholder: field.placeholder,
    hint: field.hint,
    options: typeof field.options === 'string'
      ? String(field.options).split('\n').filter(Boolean).map(line => ({ value: line.trim(), label: line.trim() }))
      : field.options,
  })),
  consent: data.consentText,
  submitLabel: data.submitLabel,
  success: { title: data.successTitle, message: data.successMessage, redirect: data.redirectTo },
  layout: { columns: Number(data.columns) === 1 ? 1 : 2, align: data.align === 'center' ? 'center' : 'left' },
};

const form = data.form || inline;

/*
 * Stable per block, so two forms on one page cannot collide on element ids —
 * which would otherwise have a label focus the wrong input.
 */
const uid = `cms-form-${block?.key || form.key || 'inline'}`;

const html = renderForm(form, {
  locale,
  uid,
  editMode,
  title: data.title || '',
  subtitle: data.subtitle || '',
  redirect: data.redirectTo || form.success?.redirect || '',
});

/*
 * The form the block asked for does not exist any more — somebody deleted it
 * while a page still pointed at it. Rendering nothing would leave a silent gap
 * on a live page, so say so in a comment an editor will find in the preview and
 * a visitor will never see.
 */
const missing = !!data.formKey && !data.form;
---

{missing
  ? <Fragment set:html={`<!-- The form "${data.formKey}" no longer exists. Choose another under Forms. -->`} />
  : <Fragment set:html={html} />}

{!missing && <script is:inline src="/js/cms-form.js" defer></script>}
