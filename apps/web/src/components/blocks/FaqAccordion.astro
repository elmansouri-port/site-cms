---
/*
 * FaqAccordion — questions authored in the CMS, rendered server-side.
 *
 * The markup is complete in the HTML (no client fetch, no useEffect) because
 * the answers are SEO-critical; <details> gives the open/close behaviour with
 * no JavaScript at all.
 */
const { data = {} } = Astro.props;
const { title = '', subtitle = '', items = [] } = data;
---

<div class="max-w-3xl mx-auto px-6">
  {title && <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center">{title}</h2>}
  {subtitle && <p class="mt-4 text-gray-600 text-center">{subtitle}</p>}

  <div class="mt-10 divide-y divide-gray-200 border-t border-gray-200">
    {items.map((item) => (
      <details class="group py-5">
        <summary class="flex items-center justify-between cursor-pointer list-none text-left">
          <span class="text-lg font-medium text-gray-900">{item.question}</span>
          <svg class="w-5 h-5 shrink-0 text-brand-500 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
        </summary>
        <div class="mt-3 text-gray-600 leading-relaxed" set:html={item.answer} />
      </details>
    ))}
  </div>
</div>
